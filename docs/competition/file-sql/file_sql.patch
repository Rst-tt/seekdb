+
+class ObSelectStmt;
+class ObSelectIntoItem;
+
+// COPY (query) TO 'file' (FORMAT CSV, HEADER, DELIMITER ',', ...)
+// COPY table TO 'file' (...)
+class ObCopyResolver : public ObDMLResolver
+{
+public:
+  explicit ObCopyResolver(ObResolverParams &params)
+      : ObDMLResolver(params),
+        select_stmt_(NULL)
+  {
+  }
